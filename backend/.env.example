DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DATABASE_URL=postgres://transfer:transfer@postgres:5432/transfer_on_line
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com

# Email OTP (Brevo, Resend SMTP, Mailjet, etc.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-smtp-login
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=no-reply@example.com
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# ==============================================================================
# GENIUSPAY
# ==============================================================================

# API key publique: pk_sandbox_... ou pk_live_...
GENIUSPAY_API_KEY=pk_sandbox_your_geniuspay_api_key
# Secret API prive: sk_sandbox_... ou sk_live_...
GENIUSPAY_API_SECRET=sk_sandbox_your_geniuspay_api_secret
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_WEBHOOK_SECRET=whsec_sandbox_your_webhook_secret
GENIUSPAY_CURRENCY=XOF
GENIUSPAY_SUCCESS_URL=https://app.example.com/payment/success
GENIUSPAY_ERROR_URL=https://app.example.com/payment/cancel
GENIUSPAY_TIMEOUT_SECONDS=30
GENIUSPAY_ALLOW_MOCK=true

# ===============================================================================
# FEEXPAY (solution primaire de paiement mobile money)
# ===============================================================================

FEEXPAY_API_KEY=fp_your_feexpay_api_key
FEEXPAY_SHOP=your-feexpay-shop-id
FEEXPAY_BASE_URL=https://api-v2.feexpay.me
FEEXPAY_CHANNEL_MTN=mtn_ci
FEEXPAY_CHANNEL_MOOV=moov_ci
FEEXPAY_CHANNEL_WAVE=wave_ci
FEEXPAY_CHANNEL_ORANGE=orange_ci
FEEXPAY_TIMEOUT_SECONDS=20

# Le relais n'est utilisé que si le provider précédent échoue avant acceptation.
PAYMENT_PROVIDER_ORDER=feexpay,geniuspay

# ==============================================================================
# AION MESSAGING (seul fournisseur OTP - /verify/start + /verify/check
# generent, envoient ET verifient le code cote Aion ; voir
# apps/accounts/services.py. Aucun mode mock : sans cle/sender_id valides,
# l'inscription/connexion par OTP ne fonctionne pas du tout.)
# ==============================================================================

AION_API_KEY=sk_sandbox_your_aion_api_key
AION_BASE_URL=https://aionmessaging.com/api/v1/
# "TRANSFERON" une fois approuve par Aion (1-3 jours ouvrables) - laisser
# vide tant que l'approbation n'est pas confirmee.
AION_SENDER_ID=
# Uniquement pour un test manuel reel (voir apps/accounts/tests.py) - ne
# devient jamais une valeur par defaut applicative, ne pas versionner un
# vrai numero ici.
OTP_TEST_PHONE_NUMBER=

# ==============================================================================
# OBSERVABILITE (tout est optionnel)
# ==============================================================================

# Laisser vide pour desactiver Sentry (aucune dependance requise dans ce cas)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# "plain" (defaut, lisible en dev) ou "json" (pour un agregateur de logs)
DJANGO_LOG_FORMAT=plain
DJANGO_LOG_LEVEL=INFO

# Une requete plus lente que ce seuil est journalisee en WARNING
SLOW_REQUEST_THRESHOLD_MS=2000

# ==============================================================================
# TRANSACTION ENGINE (bascule progressive)
# ==============================================================================

# false (defaut) : ExecuteTransactionView/TransactionResultView utilisent
# GatewayManager.select_operator_gateway() (choix operateur-safe, sans
# reservation/TransactionAttempt). true : ils utilisent Scheduler/
# ReservationManager/RetryManager (avec reservation reelle d'une SIM
# precise). Dans les deux cas, si aucune SIM eligible pour l'operateur de la
# transaction n'existe, la transaction est mise en attente (next_retry_at) -
# jamais assignee a un Gateway d'un autre operateur.
USE_NEW_TRANSACTION_ENGINE=false