DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=transfert-online.site,www.transfert-online.site,180.149.198.189
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
DATABASE_URL=postgres://transfer:<mot-de-passe-postgres>@postgres:5432/transfer_on_line
POSTGRES_NAME=transfer_on_line
POSTGRES_USER=transfer
POSTGRES_PASSWORD=<mot-de-passe-postgres>
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=https://transfert-online.site,https://www.transfert-online.site
CSRF_TRUSTED_ORIGINS=https://transfert-online.site,https://www.transfert-online.site

# ==============================================================================
# GENIUSPAY
# ==============================================================================

# API key publique: pk_sandbox_... ou pk_live_...
GENIUSPAY_API_KEY=pk_sandbox_your_geniuspay_api_key
# Secret API prive: sk_sandbox_... ou sk_live_...
GENIUSPAY_API_SECRET=sk_sandbox_your_geniuspay_api_secret
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_WEBHOOK_SECRET=whsec_sandbox_your_webhook_secret
GENIUSPAY_CURRENCY=XOF
GENIUSPAY_SUCCESS_URL=https://transfert-online.site/payment/success
GENIUSPAY_ERROR_URL=https://transfert-online.site/payment/cancel
GENIUSPAY_TIMEOUT_SECONDS=30
# Production : jamais true en dehors du developpement local - un paiement
# fictif ne doit jamais pouvoir etre accepte par accident.
GENIUSPAY_ALLOW_MOCK=false

# Production : Jèko est le fournisseur principal, GeniusPay le seul relais
# (utilisé uniquement si Jèko échoue avant acceptation). CinetPay et FeexPay
# ont été retirés entièrement du projet (aucun payment_method possible).
PAYMENT_PROVIDER_ORDER=jeko,geniuspay
TXN_MAX_RETRY=2

# ==============================================================================
# JEKO (https://developer.jeko.africa - API Payments standard, voir
# apps/payments/providers/jeko.py). X-API-KEY/X-API-KEY-ID et le storeId
# viennent du dashboard Jeko (cockpit.jeko.africa) pour le compte entreprise
# de Transfer On Line lui-meme. Pas d'environnement sandbox documente par
# Jeko : ces identifiants pointent toujours vers l'environnement reel.
# ==============================================================================

JEKO_API_KEY=your-jeko-api-key
JEKO_API_KEY_ID=your-jeko-api-key-id
JEKO_BASE_URL=https://api.jeko.africa
JEKO_STORE_ID=your-jeko-store-id
JEKO_SUCCESS_URL=https://transfert-online.site/payment/success
JEKO_ERROR_URL=https://transfert-online.site/payment/cancel
JEKO_WEBHOOK_SECRET=whsec_your_jeko_webhook_secret
JEKO_TIMEOUT_SECONDS=20


# ==============================================================================
# OBSERVABILITE (tout est optionnel)
# ==============================================================================

# Laisser vide pour desactiver Sentry (aucune dependance requise dans ce cas)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# "plain" (defaut, lisible en dev) ou "json" (pour un agregateur de logs)
DJANGO_LOG_FORMAT=plain
DJANGO_LOG_LEVEL=INFO

# Une requete plus lente que ce seuil est journalisee en WARNING
SLOW_REQUEST_THRESHOLD_MS=2000

# ==============================================================================
# TRANSACTION ENGINE (bascule progressive)
# ==============================================================================

# false (defaut) : ExecuteTransactionView/TransactionResultView utilisent
# GatewayManager.select_operator_gateway() (choix operateur-safe, sans
# reservation/TransactionAttempt). true : ils utilisent Scheduler/
# ReservationManager/RetryManager (avec reservation reelle d'une SIM
# precise). Dans les deux cas, si aucune SIM eligible pour l'operateur de la
# transaction n'existe, la transaction est mise en attente (next_retry_at) -
# jamais assignee a un Gateway d'un autre operateur.
USE_NEW_TRANSACTION_ENGINE=false