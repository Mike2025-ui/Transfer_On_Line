DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DATABASE_URL=postgres://transfer:transfer@postgres:5432/transfer_on_line
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id
CINETPAY_SECRET_KEY=your-cinetpay-secret-key
CINETPAY_NOTIFY_URL=https://api.example.com/api/payments/cinetpay/notify/
CINETPAY_RETURN_URL=https://app.example.com/payment/success
CINETPAY_CANCEL_URL=https://app.example.com/payment/cancel
